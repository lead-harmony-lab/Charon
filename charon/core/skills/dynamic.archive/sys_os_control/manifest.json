{
  "skill_id": "sys_os_control",
  "version": "1.0.0",
  "description": "Operating system command runner and GUI viewer integration tool.",
  "category": "System",
  "author": "Charon Librarian",
  "shelf_tags": [
    "system",
    "os",
    "bash",
    "gui",
    "xdg"
  ],
  "system_requirements": [
    "bash"
  ],
  "supported_actions": {
    "system_sys_execute": {
      "description": "Executes lightweight synchronous system shell commands directly.",
      "parameters": {
        "command": {
          "type": "string",
          "description": "Shell command to run.",
          "required": true
        },
        "cwd": {
          "type": "string",
          "description": "Working directory for execution context.",
          "required": false
        },
        "timeout": {
          "type": "number",
          "description": "Execution timeout in seconds (defaults to 30.0).",
          "required": false
        }
      },
      "handler": "handle_execute_system_command"
    },
    "system_sys_launch": {
      "description": "Spawns the default desktop application to open target files.",
      "parameters": {
        "file_path": {
          "type": "string",
          "description": "Path to file to open.",
          "required": true
        }
      },
      "handler": "handle_launch_gui_viewer"
    }
  },
  "allowed_agents": [
    "engineer"
  ]
}
