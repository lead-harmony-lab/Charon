{
  "skill_id": "code_python_interpreter",
  "version": "1.0.0",
  "description": "Subprocess sandbox runner for raw Python code strings and existing script files.",
  "category": "Execution",
  "author": "Charon Librarian",
  "shelf_tags": [
    "python",
    "sandbox",
    "interpreter",
    "runner"
  ],
  "system_requirements": [
    "python3"
  ],
  "supported_actions": {
    "execution_code_execute": {
      "description": "Validates and executes dynamic Python code in an isolated subshell.",
      "parameters": {
        "code": {
          "type": "string",
          "description": "Python source code string.",
          "required": true
        },
        "target_dir": {
          "type": "string",
          "description": "Directory context for process execution.",
          "required": false
        }
      },
      "handler": "handle_execute_sandbox_code"
    },
    "execution_code_run": {
      "description": "Executes a python script file located on disk.",
      "parameters": {
        "script_path": {
          "type": "string",
          "description": "Relative or absolute path to script.",
          "required": true
        }
      },
      "handler": "handle_run_existing_script"
    }
  },
  "allowed_agents": [
    "engineer"
  ]
}
