{
  "skill_id": "iot_mqtt_publisher",
  "version": "1.0.0",
  "description": "MQTT messaging interface for publishing operational commands and telemetric data payloads.",
  "category": "Execution",
  "author": "Charon Librarian",
  "shelf_tags": [
    "iot",
    "mqtt",
    "broker",
    "telemetry",
    "pubsub"
  ],
  "system_requirements": [
    "python3",
    "paho-mqtt"
  ],
  "supported_actions": {
    "execution_iot_publish": {
      "description": "Publishes a text or structured JSON payload to a specified MQTT topic.",
      "parameters": {
        "topic": {
          "type": "string",
          "description": "Target MQTT topic string (e.g., 'home/livingroom/light/set').",
          "required": true
        },
        "payload": {
          "type": "string",
          "description": "String or structured object payload to publish.",
          "required": false
        },
        "host": {
          "type": "string",
          "description": "MQTT broker host IP or domain (defaults to MQTT_BROKER_HOST env var).",
          "required": false
        },
        "port": {
          "type": "integer",
          "description": "MQTT broker port (defaults to MQTT_BROKER_PORT env var or 1883).",
          "required": false
        },
        "user": {
          "type": "string",
          "description": "Broker username for authentication.",
          "required": false
        },
        "password": {
          "type": "string",
          "description": "Broker password for authentication.",
          "required": false
        }
      },
      "handler": "handle_publish_mqtt"
    }
  },
  "allowed_agents": [
    "steward"
  ]
}
